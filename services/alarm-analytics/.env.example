# Settings for the alarm analytics service. Copy this file to .env and fill it in.
# On the Proxmox container the same lines go in /etc/alarm-analytics.env instead
# (docs/setup/alarm-analytics.md). Never commit the filled-in file or paste it anywhere.

# The MQTT broker: the address of the Home Assistant VM (Mosquitto add-on).
MQTT_HOST=
MQTT_PORT=1883

# The service's login, created in M1 (docs/setup/home-assistant.md, section 6).
MQTT_USERNAME=alarm-analytics
MQTT_PASSWORD=

# Where the alarm history is kept. A file name here is created in the folder the
# service is started from; the container uses /var/lib/alarm-analytics/history.db.
ANALYTICS_DB=alarm-analytics.db
