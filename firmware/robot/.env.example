# Settings for the alarm robot's firmware. Copy this file to .env (same folder) and fill it in.
# .env is gitignored: never commit it or paste its contents anywhere.
#
# robot.py turns .env into AlarmBot/secrets.h before every build. That header is
# gitignored too. The values end up inside the compiled firmware, so do not share
# a built .bin file either.

# The Wi-Fi the robot joins. 2.4 GHz only: the ESP32 cannot use 5 GHz.
WIFI_SSID=example-wifi
WIFI_PASSWORD=example-password

# The MQTT broker: the address of the Home Assistant VM (Mosquitto add-on).
MQTT_HOST=192.0.2.10
MQTT_PORT=1883

# The robot's login, created in M1 (docs/setup/home-assistant.md, section 6).
MQTT_USERNAME=alarmbot
MQTT_PASSWORD=example-password

# Password for updates over Wi-Fi. Make up a long one and keep it in your
# password manager; the same value must be in .env on any PC that updates the robot.
OTA_PASSWORD=example-password

# Where robot.py finds the robot for a Wi-Fi update. The name works on most home
# networks; use the robot's IP address if it does not.
ROBOT_ADDRESS=alarmbot.local
